# Copy to .env (git-ignored). All values are public (shipped to the browser).
# Handover contract account on NEAR testnet (required).
PUBLIC_HANDOVER_CONTRACT=
# NEAR testnet RPC (default https://test.rpc.fastnear.com)
PUBLIC_NEAR_RPC=https://test.rpc.fastnear.com
# Sepolia RPC with browser CORS (default https://ethereum-sepolia-rpc.publicnode.com)
PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
# MPC signer contract (default v1.signer-prod.testnet)
PUBLIC_MPC_CONTRACT=v1.signer-prod.testnet
