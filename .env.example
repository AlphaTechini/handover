# Copy this file to .env (git-ignored) and fill in your own values.
#   cp .env.example .env
# The capability checks in checks/ read .env from this folder. Real environment
# variables override the file. Never commit .env or put a private key in any file
# that is committed. Lines starting with # are comments.

# ---- NEAR testnet -------------------------------------------------------------

# Your testnet account, e.g. alice.testnet. Created by check 1 (see its output).
NEAR_ACCOUNT_ID=

# Raw NEAR private key (ed25519:...). The checks do not read it. near-cli-rs keeps
# keys under ~/.near-credentials (the *-legacy-keychain commands). Leave blank unless
# a script you add signs with a raw key.
NEAR_PRIVATE_KEY=

# NEAR testnet JSON-RPC endpoint.
NEAR_RPC=https://test.rpc.fastnear.com

# MPC signer contract on testnet. Its root key is pinned in checks/03-address-agreement.ts.
MPC_CONTRACT=v1.signer-prod.testnet

# Account the capability probe (checks/02-mpc-sign/) is deployed to, e.g. probe.alice.testnet.
PROBE_CONTRACT=

# Account the Handover NFT contract is deployed to (checks 3, 5).
HANDOVER_CONTRACT=

# ---- Sepolia ------------------------------------------------------------------

# Ethereum JSON-RPC endpoint for Sepolia (chain id 11155111).
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Optional. An address you funded from the Sepolia faucet. Check 1 uses it when no
# address is given on the command line. Check 6 uses it for eth_getTransactionCount.
SEPOLIA_FUNDED_ADDRESS=

# ---- Handover -----------------------------------------------------------------

# Token id to check (decimal). Check 5 derives the wallet for handover-<TOKEN_ID>.
TOKEN_ID=0
