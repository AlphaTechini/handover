      {
        "name": "on_signed",
        "doc": " MPC callback. NEVER panics once authorised: every parse/validation problem is treated as\n a failed attempt that leaves the reservation in place (decision D1).\n\n The promise result is read and parsed by hand (no typed `#[callback_result]`), so an\n MPC response of an unexpected shape, garbage bytes or a failed promise are all recorded\n as `sign_failed` instead of aborting the callback.\n\n `#[private]` is enforced only in the compiled wasm wrapper, not in unit tests, so the\n explicit predecessor check below makes the same rule testable and survives refactors.",
        "kind": "call",
        "modifiers": [
          "private"
        ],
        "params": {
          "serialization_type": "json",
          "args": [
            {
              "name": "token_id",
              "type_schema": {
                "type": "string"
              }
            },
            {
              "name": "nonce",
              "type_schema": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            }
          ]
        },
        "result": {
          "serialization_type": "json",
          "type_schema": {
            "anyOf": [
              {
                "$ref": "#/definitions/SignedTxView"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      {
        "name": "release_stuck",
        "doc": " Recovery when the in-flight attempt never calls back (for example the callback ran out\n of gas): owner only, exactly 1 yocto, only while `in_flight` and more than\n `RELEASE_AFTER_BLOCKS` blocks after the latest `sign` call (MPC's own yield timeout is\n 200 blocks). Clears `in_flight` and KEEPS the reservation, which is exactly the state of\n a failed attempt, so it cannot lose track of a signature that may exist. Use\n `retry_reserved` afterwards.",
        "kind": "call",
        "modifiers": [
          "payable"
        ],
        "params": {
          "serialization_type": "json",
          "args": [
            {
              "name": "token_id",
              "type_schema": {
                "type": "string"
              }
            }
          ]
        }
      },
      {
        "name": "request_transfer",
        "doc": " Ask MPC to sign a plain ETH transfer from this token's address. Owner only.\n\n Deposit: more than `SIGN_FEE` (at least `SIGN_FEE` + 1 yocto). The contract keeps\n `SIGN_FEE` to pay for the log/reservation storage and forwards the REST to the MPC `sign`\n call as its fee (no refund to the caller, so callers can follow a future MPC fee change).\n Attach 300 Tgas. Returns the logged `SignedTxView` (via callback) or null if signing\n failed (then call `retry_reserved`).\n\n There is intentionally NO parameter for calldata, access list, or chain id.",
        "kind": "call",
        "modifiers": [
          "payable"
        ],
        "params": {
          "serialization_type": "json",
          "args": [
            {
              "name": "token_id",
              "type_schema": {
                "type": "string"
              }
            },
            {
              "name": "to",
              "type_schema": {
                "type": "string"
              }
            },
            {
              "name": "value_wei",
              "type_schema": {
                "type": "string"
              }
            },
            {
              "name": "gas_limit",
              "type_schema": {
                "type": "string"
              }
            },
            {
              "name": "max_fee_per_gas",
              "type_schema": {
                "type": "string"
              }
            },
            {
              "name": "max_priority_fee_per_gas",
              "type_schema": {
                "type": "string"
              }
            }
          ]
        },
        "result": {
          "serialization_type": "json",
          "type_schema": {
