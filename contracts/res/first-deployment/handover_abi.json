    "functions": [
      {
        "name": "buy",
        "doc": " Buy a listed token. Attach EXACTLY the price (no refund path) and pass the wallet's\n `next_nonce` as you verified it. If the wallet changed since your clean check (for\n example the seller delisted, signed and relisted) `next_nonce` moved and the call fails.\n\n Everything happens in this one call (risk 4): the listing is removed, the NFT moves to\n the buyer (approvals are cleared by the standard transfer), and the seller is paid\n exactly `price`. If any step panics the whole call reverts.",
        "kind": "call",
        "modifiers": [
          "payable"
        ],
        "params": {
          "serialization_type": "json",
          "args": [
            {
              "name": "token_id",
              "type_schema": {
                "type": "string"
              }
            },
            {
              "name": "expected_next_nonce",
              "type_schema": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            }
          ]
        }
      },
